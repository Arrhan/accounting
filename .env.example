# Runtime DB — Supabase transaction pooler (port 6543); the app connects with prepare: false.
# NOTE: percent-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Migrations only (drizzle-kit migrate) — session pooler: same host/credentials, port 5432.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# SimpleFIN Access URL with embedded Basic Auth credentials, exactly as returned by the
# claim endpoint. The value below is SimpleFIN's public demo — safe to use, not a secret.
SIMPLEFIN_ACCESS_URL=https://demo:demo@beta-bridge.simplefin.org/simplefin

# Bearer token required by GET /api/sync. Generate with: openssl rand -hex 32
CRON_SECRET=

# Anthropic API key (unused until the categorization slice)
CLAUDE_KEY=

# Single-user login password for the web UI. Choose your own strong password.
APP_PASSWORD=

# HMAC key signing the session cookie. Generate with: openssl rand -hex 32
# Use a DIFFERENT value in production than locally (rotating it logs out all sessions).
SESSION_SECRET=
